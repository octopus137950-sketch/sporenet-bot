# ============================================================
# .env.example — คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#
# วิธีใช้ใน Termux:
#   cp .env.example .env
#   nano .env
# ============================================================

# ── จำเป็นต้องกรอก ──────────────────────────────────────────
DISCORD_TOKEN=ใส่_bot_token_ของคุณ_ที่นี่
DISCORD_CLIENT_ID=ใส่_application_id_ของคุณ_ที่นี่

# ── ที่เก็บข้อมูลบอท (bot_data.json) ────────────────────────
# ถ้าไม่กรอก จะเก็บที่ ~/sporenet-data โดยอัตโนมัติ
# DATA_DIR=/data/data/com.termux/files/home/sporenet-data

# ── AI Chatbot (Groq) ─────────────────────────────────────────
# GROQ_API_KEY=ใส่_groq_api_key_ของคุณ

# ── Server port ──────────────────────────────────────────────
PORT=8080
